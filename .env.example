# Gere uma chave exclusiva para cada ambiente. Não use este valor em produção.
SECRET_KEY=troque-por-uma-chave-secreta-forte

# Desenvolvimento local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
PORT=8000

# Opcional: sem esta variável, o projeto usa SQLite em db.sqlite3.
# Para PostgreSQL, use uma URL no formato:
# DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco
